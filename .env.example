# ---------------------------------------------------------------------------
# Wiwaha OS environment variables. Copy to apps/web/.env.local for local dev
# and add the same keys in Vercel → Project → Settings → Environment Variables.
# Never commit real values.
# ---------------------------------------------------------------------------

# --- Supabase (Phase 1) -----------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Used by the website lead form, cron jobs and the agent worker.
SUPABASE_SERVICE_ROLE_KEY=

# --- App ---------------------------------------------------------------------
# Public base URL of the deployed app (used in invite and portal emails).
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Shared secret that Vercel Cron / Supabase cron sends as "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=

# --- Claude API (Phase 1) ---------------------------------------------------
# Without a key, agents fall back to deterministic templates so the app still works.
ANTHROPIC_API_KEY=

# --- Webhooks (Phase 2) -----------------------------------------------------
# Shared key for our own inbound webhooks (?k=… or x-webhook-key) and Plivo voice URLs.
WEBHOOK_SECRET=
# Comma-separated origins allowed to post the public enquiry form (optional).
LEAD_FORM_ALLOWED_ORIGINS=

# Every channel below runs in SANDBOX mode while its keys are empty: messages,
# calls, payment links and signatures are recorded in the outbox and nothing
# leaves the building. Get Prashanth's written OK before filling live keys.

# --- WhatsApp Business via BSP (Phase 2) ------------------------------------
WHATSAPP_BSP=gupshup
WHATSAPP_API_KEY=
WHATSAPP_SENDER_NUMBER=
GUPSHUP_APP_NAME=

# --- Instagram DMs and Meta lead forms (Phase 2) ---------------------------
META_APP_SECRET=
META_VERIFY_TOKEN=
META_PAGE_ACCESS_TOKEN=

# --- Google Ads lead forms (Phase 2) ----------------------------------------
GOOGLE_ADS_WEBHOOK_KEY=

# --- Telephony: Voice Concierge (Phase 2) -----------------------------------
TELEPHONY_PROVIDER=plivo
PLIVO_AUTH_ID=
PLIVO_AUTH_TOKEN=
PLIVO_NUMBER=

# --- Email (Phase 2) --------------------------------------------------------
EMAIL_FROM="Wiwaha by Praman <hello@example.com>"
RESEND_API_KEY=

# --- Payments: Razorpay (Phase 3; test keys until go-live) ------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- E-signature (Phase 3; sandbox page until an account exists) ------------
DIGIO_CLIENT_ID=
LEEGALITY_API_KEY=

# --- Demo only ------------------------------------------------------------
# true = hand out the test pay and sign pages (they mark payments paid and
# contracts signed WITHOUT checks). Never set this where real couples are.
ALLOW_SANDBOX_LINKS=
