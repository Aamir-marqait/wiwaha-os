# ---------------------------------------------------------------------------
# Wiwaha OS environment variables. Copy to apps/web/.env.local for local dev
# and add the same keys in Vercel → Project → Settings → Environment Variables.
# Never commit real values.
# ---------------------------------------------------------------------------

# --- Supabase (Phase 1) -----------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Used by the website lead form, cron jobs and the agent worker.
SUPABASE_SERVICE_ROLE_KEY=

# --- App ---------------------------------------------------------------------
# Public base URL of the deployed app (used in invite and portal emails).
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Shared secret that Vercel Cron / Supabase cron sends as "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=

# --- Claude API (Phase 1) ---------------------------------------------------
# Without a key, agents fall back to deterministic templates so the app still works.
ANTHROPIC_API_KEY=

# --- Scheduling (optional; Phase 1 uses Vercel Cron + pg_cron) --------------
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# --- WhatsApp Business via BSP (Phase 2) ------------------------------------
WHATSAPP_BSP=gupshup
WHATSAPP_API_KEY=
WHATSAPP_SENDER_NUMBER=

# --- Telephony (Phase 2) ----------------------------------------------------
TELEPHONY_PROVIDER=exotel
EXOTEL_SID=
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_CALLER_ID=

# --- Email (Phase 2) --------------------------------------------------------
EMAIL_FROM="Wiwaha by Praman <hello@example.com>"
SMTP_URL=

# --- Payments (Phase 3) -----------------------------------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- E-signature (Phase 3) --------------------------------------------------
ESIGN_PROVIDER=digio
DIGIO_CLIENT_ID=
DIGIO_CLIENT_SECRET=
